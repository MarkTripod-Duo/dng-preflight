# serializer version: 1
# name: test_scripted_config_snapshot
  '''
  # Auto-generated by dng-preflight. Review before applying.
  # DNG minimum version: 3.3.0
  # Scope: web_ssh_rdp_smb
  # IdP: okta

  network_gateway:
    hostname: 'dng.example.com'
    enable_ui: true
    password: '<<SET BEFORE FIRST RUN — min 8 chars, mixed case, digit, symbol>>'
    admin_email: 'admin@example.com'
    load_balancer_cidrs_ips:
      - '10.0.0.0/8'
    ssl_cert:
      source: own
      cert: |
        <<paste contents of /etc/ssl/dng/cert.pem>>
      key: |
        <<paste contents of /etc/ssl/dng/key.pem>>

  primary_auth:
    # Filled in at RUNBOOK Step 4 (after IdP returns its metadata).
    entity_id: '<<IdP entity ID — see RUNBOOK Step 4>>'
    single_signon_url: '<<IdP SSO URL — see RUNBOOK Step 4>>'
    signing_cert: |
      <<paste IdP signing certificate PEM>>

  web_applications:
    web-1:
      external_hostname: '<<set: e.g. web-1.example.com>>'
      internal_hostname: '<<set: internal FQDN or IP>>'
      internal_port: 443
      internal_use_ssl: true
      external_ssl_cert:
        source: own
        cert: |
          <<see network_gateway.ssl_cert.cert>>
        key: |
          <<see network_gateway.ssl_cert.key>>
      duo_2fa:
        ikey: '<<Duo Admin Panel: integration ikey>>'
        skey: '<<Duo Admin Panel: integration skey>>'
        api_host: '<<api-XXXXXXXX.duosecurity.com>>'
    web-2:
      external_hostname: '<<set: e.g. web-2.example.com>>'
      internal_hostname: '<<set: internal FQDN or IP>>'
      internal_port: 443
      internal_use_ssl: true
      external_ssl_cert:
        source: own
        cert: |
          <<see network_gateway.ssl_cert.cert>>
        key: |
          <<see network_gateway.ssl_cert.key>>
      duo_2fa:
        ikey: '<<Duo Admin Panel: integration ikey>>'
        skey: '<<Duo Admin Panel: integration skey>>'
        api_host: '<<api-XXXXXXXX.duosecurity.com>>'

  ssh_servers:
    ssh-1:
      external_hostname: '<<set: e.g. ssh-1.example.com>>'
      external_ssl_cert:
        source: own
        cert: |
          <<see network_gateway.ssl_cert.cert>>
        key: |
          <<see network_gateway.ssl_cert.key>>
      internal_servers:
        - host_pattern: '<<internal hostname pattern, * supported>>'
          ports: '22'
      duo_2fa:
        ikey: '<<Duo Admin Panel: integration ikey>>'
        skey: '<<Duo Admin Panel: integration skey>>'
        api_host: '<<api-XXXXXXXX.duosecurity.com>>'

  application_relays:
    rdp-1:
      application_type: 'rdp'
      external_hostname: '<<set: e.g. rdp-1.example.com>>'
      external_ssl_cert:
        source: own
        cert: |
          <<see network_gateway.ssl_cert.cert>>
        key: |
          <<see network_gateway.ssl_cert.key>>
      internal_servers:
        - host_pattern: '<<internal hostname pattern, * supported>>'
      duo_2fa:
        ikey: '<<Duo Admin Panel: integration ikey>>'
        skey: '<<Duo Admin Panel: integration skey>>'
        api_host: '<<api-XXXXXXXX.duosecurity.com>>'

  subdomains: []

  '''
# ---
