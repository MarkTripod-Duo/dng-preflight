# serializer version: 1
# name: test_firewall_snapshot_ufw
  '''
  #!/usr/bin/env bash
  # Auto-generated by dng-preflight. ufw firewall rules for DNG.
  # Scope: web_ssh_rdp_smb

  set -euo pipefail

  if ! command -v ufw >/dev/null 2>&1; then
      printf 'ufw is not installed; aborting\n' >&2
      exit 1
  fi

  if [[ "${EUID}" -ne 0 ]]; then
      printf 'must run as root (use sudo)\n' >&2
      exit 1
  fi

  # Public traffic: 443 from anywhere (clients reach DNG via HTTPS)
  ufw allow 443/tcp

  # Admin console (8443): restricted to admin CIDRs only
  ufw allow from 10.0.0.0/8 to any port 8443 proto tcp

  # RDP relay (3389): publicly reachable for RDP clients
  ufw allow 3389/tcp
  # SMB relay (445): restricted to known client CIDRs only (no public exposure)
  # Add per-CIDR rules below for any internal SMB clients that should reach DNG.

  # Explicitly deny 8443 from anywhere else
  ufw deny 8443/tcp

  ufw --force enable
  ufw status verbose

  '''
# ---
