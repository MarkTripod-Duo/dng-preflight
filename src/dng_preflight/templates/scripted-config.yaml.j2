# Auto-generated by dng-preflight. Review before applying.
# DNG minimum version: {{ config.dng_version_minimum }}
# Scope: {{ config.answers.deployment_scope }}
# IdP: {{ config.answers.idp }}

network_gateway:
  hostname: {{ config.answers.public_hostname | yaml_str }}
  enable_ui: true
  password: '<<SET BEFORE FIRST RUN — min 8 chars, mixed case, digit, symbol>>'
  admin_email: {{ admin_email | yaml_str }}
{% if config.answers.load_balancer %}
  load_balancer_cidrs_ips:
{% for cidr in config.answers.load_balancer.trusted_proxies %}
    - {{ cidr | string | yaml_str }}
{% endfor %}
{% endif %}
  ssl_cert:
{% if tls_kind == 'lets_encrypt_dns01' %}
    source: letsencrypt
{% else %}
    source: own
    cert: |
{{ ('<<paste contents of ' ~ config.answers.tls_strategy.cert_path ~ '>>') | pem_block(indent=6) }}
    key: |
{{ ('<<paste contents of ' ~ config.answers.tls_strategy.key_path ~ '>>') | pem_block(indent=6) }}
{% if tls_kind == 'internal_ca' %}
    # chain: |
{{ ('#   <<paste contents of ' ~ config.answers.tls_strategy.chain_path ~ '>>') | pem_block(indent=6) }}
{% endif %}
{% endif %}

primary_auth:
  # Filled in at RUNBOOK Step 4 (after IdP returns its metadata).
  entity_id: '<<IdP entity ID — see RUNBOOK Step 4>>'
  single_signon_url: '<<IdP SSO URL — see RUNBOOK Step 4>>'
  signing_cert: |
    <<paste IdP signing certificate PEM>>

web_applications:
{% if not config.answers.seed_apps.web_apps %}
  # No web applications seeded; add entries here keyed by friendly name.
  {}
{% endif %}
{% for app in config.answers.seed_apps.web_apps %}
  {{ app.name }}:
    external_hostname: '<<set: e.g. {{ app.name }}.{{ public_hostname_domain }}>>'
    internal_hostname: '<<set: internal FQDN or IP>>'
    internal_port: 443
    internal_use_ssl: true
    external_ssl_cert:
      source: own
      cert: |
        <<see network_gateway.ssl_cert.cert>>
      key: |
        <<see network_gateway.ssl_cert.key>>
    duo_2fa:
      ikey: '<<Duo Admin Panel: integration ikey>>'
      skey: '<<Duo Admin Panel: integration skey>>'
      api_host: '<<api-XXXXXXXX.duosecurity.com>>'
{% endfor %}

ssh_servers:
{% if not config.answers.seed_apps.ssh_relays %}
  # No SSH relays seeded; add entries here keyed by friendly name.
  {}
{% endif %}
{% for relay in config.answers.seed_apps.ssh_relays %}
  {{ relay.name }}:
    external_hostname: '<<set: e.g. {{ relay.name }}.{{ public_hostname_domain }}>>'
    external_ssl_cert:
      source: own
      cert: |
        <<see network_gateway.ssl_cert.cert>>
      key: |
        <<see network_gateway.ssl_cert.key>>
    internal_servers:
      - host_pattern: '<<internal hostname pattern, * supported>>'
        ports: '22'
    duo_2fa:
      ikey: '<<Duo Admin Panel: integration ikey>>'
      skey: '<<Duo Admin Panel: integration skey>>'
      api_host: '<<api-XXXXXXXX.duosecurity.com>>'
{% endfor %}
{% if config.requires_extra_dns_container %}

application_relays:
{% if not config.answers.seed_apps.rdp_relays %}
  # No RDP relays seeded; add entries here keyed by friendly name.
  {}
{% endif %}
{% for relay in config.answers.seed_apps.rdp_relays %}
  {{ relay.name }}:
    application_type: 'rdp'
    external_hostname: '<<set: e.g. {{ relay.name }}.{{ public_hostname_domain }}>>'
    external_ssl_cert:
      source: own
      cert: |
        <<see network_gateway.ssl_cert.cert>>
      key: |
        <<see network_gateway.ssl_cert.key>>
    internal_servers:
      - host_pattern: '<<internal hostname pattern, * supported>>'
    duo_2fa:
      ikey: '<<Duo Admin Panel: integration ikey>>'
      skey: '<<Duo Admin Panel: integration skey>>'
      api_host: '<<api-XXXXXXXX.duosecurity.com>>'
{% endfor %}

subdomains: []
{% endif %}
