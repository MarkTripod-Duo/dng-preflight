#!/usr/bin/env bash
# Auto-generated by dng-preflight. firewalld rules for DNG.
# Scope: {{ config.answers.deployment_scope }}

set -euo pipefail

if ! command -v firewall-cmd >/dev/null 2>&1; then
    printf 'firewalld is not installed; aborting\n' >&2
    exit 1
fi

if [[ "${EUID}" -ne 0 ]]; then
    printf 'must run as root (use sudo)\n' >&2
    exit 1
fi

# Public zone: 443 reachable from anywhere
firewall-cmd --permanent --zone=public --add-port=443/tcp

{% if admin_cidrs %}
# Admin console (8443): restricted via the trusted zone
firewall-cmd --permanent --zone=trusted --add-port=8443/tcp
{% for cidr in admin_cidrs %}
firewall-cmd --permanent --zone=trusted --add-source={{ cidr }}
{% endfor %}
{% else %}
# Admin console (8443): NO trusted CIDRs configured.
# Add CIDRs to the trusted zone before bringing DNG up, e.g.:
#   firewall-cmd --permanent --zone=trusted --add-source=10.0.0.0/8
{% endif %}

{% if config.requires_extra_dns_container %}
# RDP relay (3389)
firewall-cmd --permanent --zone=public --add-port=3389/tcp
{% endif %}

firewall-cmd --reload
firewall-cmd --list-all
