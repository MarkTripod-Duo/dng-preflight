#!/usr/bin/env bash
# Auto-generated by dng-preflight. Idempotent installer for DNG.
# Scope: {{ config.answers.deployment_scope }}
# DNG minimum version: {{ config.dng_version_minimum }}

set -euo pipefail

PUBLIC_HOSTNAME='{{ config.answers.public_hostname }}'
DNG_VERSION='{{ config.dng_version_minimum }}'
DNG_IMAGE="duosecurity/network-gateway:${DNG_VERSION}"
CONFIG_DIR='/etc/dng'

log() {
    printf '[dng-preflight] %s\n' "$*"
}

die() {
    printf '[dng-preflight] FATAL: %s\n' "$*" >&2
    exit 1
}

require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        die 'must run as root (use sudo)'
    fi
}

detect_distro() {
    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        printf '%s' "${ID:-unknown}"
    else
        printf 'unknown'
    fi
}

install_docker_ubuntu() {
    log 'installing docker via apt'
    apt-get update -y
    apt-get install -y ca-certificates curl gnupg
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
        | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg
    codename=$(. /etc/os-release && printf '%s' "${VERSION_CODENAME}")
    printf \
        'deb [arch=%s signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu %s stable\n' \
        "$(dpkg --print-architecture)" "${codename}" \
        > /etc/apt/sources.list.d/docker.list
    apt-get update -y
    apt-get install -y docker-ce docker-ce-cli containerd.io \
        docker-buildx-plugin docker-compose-plugin
}

install_docker_rhel() {
    log 'installing docker via dnf'
    dnf install -y dnf-plugins-core
    dnf config-manager --add-repo https://download.docker.com/linux/rhel/docker-ce.repo
    dnf install -y docker-ce docker-ce-cli containerd.io \
        docker-buildx-plugin docker-compose-plugin
    systemctl enable --now docker
}

ensure_docker() {
    if command -v docker >/dev/null 2>&1; then
        log 'docker already installed'
        return
    fi
    distro=$(detect_distro)
    case "${distro}" in
        ubuntu | debian)
            install_docker_ubuntu
            ;;
        rhel | rocky | almalinux | centos)
            install_docker_rhel
            ;;
        *)
            die "unsupported distro: ${distro}"
            ;;
    esac
}

verify_not_domain_joined() {
    if command -v realm >/dev/null 2>&1; then
        if realm list 2>/dev/null | grep -q '^[^[:space:]]'; then
            die 'host is domain-joined; DNG must run on a non-domain-joined host'
        fi
    fi
    if [[ -r /etc/krb5.conf ]] && grep -Eq '^[[:space:]]*default_realm' /etc/krb5.conf; then
        die '/etc/krb5.conf indicates a Kerberos realm; DNG must run on a non-domain-joined host'
    fi
}

verify_hostname_resolves() {
    if ! getent hosts "${PUBLIC_HOSTNAME}" >/dev/null 2>&1; then
        die "public hostname ${PUBLIC_HOSTNAME} does not resolve; publish DNS records first (see RUNBOOK Step 0)"
    fi
}

prepare_config_dir() {
    log "preparing ${CONFIG_DIR}"
    install -m 0750 -d "${CONFIG_DIR}"
    if [[ -f scripted-config.yaml ]]; then
        install -m 0640 scripted-config.yaml "${CONFIG_DIR}/scripted-config.yaml"
    fi
}

pull_dng_image() {
    log "pulling ${DNG_IMAGE}"
    docker pull "${DNG_IMAGE}"
}

main() {
    require_root
    verify_not_domain_joined
    verify_hostname_resolves
    ensure_docker
    prepare_config_dir
    pull_dng_image
    log 'install complete; next steps are in RUNBOOK.md'
}

main "$@"
